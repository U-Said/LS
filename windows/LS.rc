#include <winres.h>
#include "resource.h"

IDI_LS ICON "LS.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,2,0,0
 PRODUCTVERSION 2,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "U-Said"
            VALUE "FileDescription", "FastRevers"
            VALUE "FileVersion", "2.2.0"
            VALUE "InternalName", "FastRevers"
            VALUE "LegalCopyright", "Copyright (c) 2026 U-Said. MIT License"
            VALUE "OriginalFilename", "FastRevers.exe"
            VALUE "ProductName", "FastRevers"
            VALUE "ProductVersion", "2.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
